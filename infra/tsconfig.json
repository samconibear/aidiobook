{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "es2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "cdk.out"
  },
  "include": [
    "bin/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cdk.out"
  ]
}
